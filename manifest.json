{
  "manifest_version": 3,
  "name": "Squash - Tab Optimizer & Memory Saver",
  "short_name": "Squash",
  "version": "1.0.0",
  "description": "Collapse open tabs into a clean list with a single click. Save up to 95% RAM and prevent browser slowdowns.",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "favicon"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Squash Open Tabs",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "list.html",
    "open_in_tab": true
  },
  "commands": {
    "squash-tabs": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Squash open tabs in current window"
    },
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open Squash Dashboard"
    }
  }
}
